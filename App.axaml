<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PdfLibrary.App"
             RequestedThemeVariant="Light">

    <!-- Стили программы: порядок важен — словари ресурсов, тема Fluent, затем свои стили. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PdfLibrary/Assets/Styles/Colors.axaml" />
                <ResourceInclude Source="avares://PdfLibrary/Assets/Styles/Icons.axaml" />
                <!-- Копии тем ContextMenu/ToolTip с зум-оберткой: попапы меню и подсказок
                     иначе не масштабируются зумом программы. -->
                <ResourceInclude Source="avares://PdfLibrary/Assets/Styles/ZoomPopupThemes.axaml" />
                <!-- Копия темы ComboBox: заглушка «Список пуст», выпадашка не шире поля. -->
                <ResourceInclude Source="avares://PdfLibrary/Assets/Styles/ComboBoxTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Иконка программы для всех окон: заголовок, панель задач, Alt-Tab. .ico, а не .png:
             Win32 сам берет готовый слой нужного размера, и значок не выходит мыльным. На macOS
             иконка окна не показывается — там она из .app-бандла. -->
        <Style Selector="Window">
            <Setter Property="Icon" Value="/Assets/Branding/icon.ico" />
        </Style>
        <StyleInclude Source="avares://PdfLibrary/Assets/Styles/Typography.axaml" />
        <!-- Стандарт габаритов диалоговых окон -->
        <StyleInclude Source="avares://PdfLibrary/Assets/Styles/WindowMetrics.axaml" />
        <StyleInclude Source="avares://PdfLibrary/Assets/Styles/Controls.axaml" />
        <StyleInclude Source="avares://PdfLibrary/Controls/Widgets/AppCheckBox.axaml" />
    </Application.Styles>

</Application>
