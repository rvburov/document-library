<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:PdfLibrary.Controls"
             xmlns:s="using:PdfLibrary.Views.Settings"
             x:Class="PdfLibrary.Views.Settings.SettingsView"
             x:DataType="s:SettingsViewModel">

    <!--
      Экран «Настройки» (макет, доски 5–10): разделы слева с иконками и раздел справа. Все
      значения действуют сразу — кнопки «Сохранить» нет.
    -->
    <Grid x:Name="Layout" ColumnDefinitions="232,*">

        <Border x:Name="Nav" Grid.Column="0"
                BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="{StaticResource BorderLineRight}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="{StaticResource NavbarHeight}" Padding="18,0"
                        BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="{StaticResource BorderLineBottom}">
                    <TextBlock Text="Настройки" Classes="title" VerticalAlignment="Center" />
                </Border>
                <StackPanel x:Name="NavList" Margin="8" Spacing="0" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Height="{StaticResource NavbarHeight}" Padding="24,0"
                    BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="{StaticResource BorderLineBottom}">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <TextBlock x:Name="SectionTitle" Classes="title" VerticalAlignment="Center" />
                    <StackPanel x:Name="DiagActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <Button Theme="{StaticResource SecondaryButton}" CornerRadius="{StaticResource RadiusSmall}"
                                Click="OnExportLog">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <c:Icon Classes="small" Data="{StaticResource IconDownload}" />
                                <TextBlock Text="Выгрузить в CSV" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Theme="{StaticResource SecondaryButton}" CornerRadius="{StaticResource RadiusSmall}"
                                Content="Очистить журнал" Click="OnClearLog" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="Scroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                <Panel MaxWidth="808" HorizontalAlignment="Left" Margin="24,8,24,32">

                    <!-- ══ Общее ══════════════════════════════════════════════ -->
                    <StackPanel x:Name="General">
                        <TextBlock Classes="h2" Text="ЗАПУСК И РАБОТА В ФОНЕ" />
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Запускать при входе в систему" />
                                            <TextBlock Classes="desc" Text="{Binding AutostartDescription}" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding Autostart}"
                                                      IsEnabled="{Binding AutostartSupported}" />
                                    </Grid>
                                </Border>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Работать в фоне при закрытом окне" />
                                            <TextBlock Classes="desc" Text="Закрытие окна сворачивает программу в значок у часов; наблюдение за папками и чтение продолжаются. Выход — через меню значка." />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding Background}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="h2" Text="УВЕДОМЛЕНИЯ" />
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Новые документы в источниках" />
                                            <TextBlock Classes="desc" Text="Системное уведомление, когда в папках появились новые PDF. Стандартно выключено." />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding NotifyNew}" />
                                    </Grid>
                                </Border>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Чтение документов закончено" />
                                            <TextBlock Classes="desc" Text="Уведомление, когда фоновое чтение текста завершилось. Стандартно выключено." />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding NotifyRead}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="h2" Text="ОТКРЫТИЕ ДОКУМЕНТОВ" />
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Программа для кнопки «Открыть»" />
                                            <TextBlock Classes="desc" Text="Куда отдать PDF целиком — для печати, правки или подписи." />
                                        </StackPanel>
                                        <ComboBox x:Name="OpenWithBox" Grid.Column="1" Width="200"
                                                  SelectionChanged="OnOpenWithChanged" />
                                    </Grid>
                                </Border>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Открывать при запуске последний документ" />
                                            <TextBlock Classes="desc" Text="В панели чтения, на той странице, где закончили читать." />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding ReopenLast}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══ Источники и чтение ═════════════════════════════════ -->
                    <StackPanel x:Name="Sources" IsVisible="False">
                        <TextBlock Classes="h2" Text="ПАПКИ С PDF" />
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,8">
                            <Border Height="30" Padding="8,0" CornerRadius="{StaticResource RadiusSmall}"
                                    BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="1" MinWidth="180">
                                <Grid ColumnDefinitions="Auto,*">
                                    <c:Icon Classes="small" Data="{StaticResource IconSearch}"
                                            Foreground="{DynamicResource BrushSecondaryText}" />
                                    <TextBox x:Name="FolderQuery" Grid.Column="1" Classes="bare" Margin="6,0,0,0"
                                             Watermark="Найти папку по названию или пути" TextChanged="OnFolderQuery" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Classes="segment" Margin="8,0,0,0">
                                <StackPanel x:Name="FolderFilters" Orientation="Horizontal" />
                            </Border>
                            <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    CornerRadius="{StaticResource RadiusSmall}" Click="OnCheckAll">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <c:Icon Classes="small" Data="{StaticResource IconRefresh}" />
                                    <TextBlock Text="Проверить все" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Theme="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    CornerRadius="{StaticResource RadiusSmall}" Click="OnAddFolder">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <c:Icon Classes="small" Data="{StaticResource IconPlus}" />
                                    <TextBlock Text="Добавить папку" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="FolderSummary" Classes="small muted" Margin="2,0,0,8" />
                        <Border Classes="group">
                            <StackPanel>
                                <Border Background="{DynamicResource BrushSecondaryBg}" Padding="14,6"
                                        BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="{StaticResource BorderLineBottom}">
                                    <Grid ColumnDefinitions="2*,3*,70,170,30">
                                        <TextBlock Text="Название" Classes="small muted bold" />
                                        <TextBlock Grid.Column="1" Text="Путь" Classes="small muted bold" />
                                        <TextBlock Grid.Column="2" Text="PDF" Classes="small muted bold" TextAlignment="Right" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="3" Text="Состояние" Classes="small muted bold" />
                                    </Grid>
                                </Border>
                                <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="FolderRows">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="s:FolderRow">
                                                <Border Padding="14,0" Height="36" BorderBrush="{DynamicResource BrushSeparator}"
                                                        BorderThickness="{StaticResource BorderLineBottom}">
                                                    <Grid ColumnDefinitions="2*,3*,70,170,30" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Path}" Classes="small muted"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="12"
                                                                   TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding Dot}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{Binding StatusBrush}"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Button Grid.Column="4" Theme="{StaticResource IconButton}"
                                                                ToolTip.Tip="Действия с папкой" Click="OnFolderMenu">
                                                            <c:Icon Classes="small" Data="{StaticResource IconMore}" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock x:Name="NoFolders" Classes="small muted" Margin="14,12" IsVisible="False"
                                           Text="Папок с таким названием или путем нет." />
                            </StackPanel>
                        </Border>
                        <TextBlock Classes="note" Text="Папку можно выбрать или вставить путь — локальный или сетевой, например \\srv-01\archive. Папки с проблемами всегда стоят в начале списка." />

                        <TextBlock Classes="h2" Text="НАБЛЮДЕНИЕ И ЧТЕНИЕ" />
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Следить за папками" />
                                            <TextBlock Classes="desc" Text="Новые и измененные PDF появляются в ленте сами, удаленные помечаются «файл не найден»." />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding Watch}" />
                                    </Grid>
                                </Border>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Читать новые документы сразу" />
                                            <TextBlock Classes="desc" Text="Текст для поиска читается в фоне. Выключено — кнопкой «Прочитать» под строкой поиска." />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding ReadAuto}" />
                                    </Grid>
                                </Border>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Не читать файлы тяжелее" />
                                            <TextBlock Classes="desc" Text="Большие файлы остаются в ленте, но ищутся только по названию." />
                                        </StackPanel>
                                        <ComboBox x:Name="MaxFileBox" Grid.Column="1" Width="120" SelectionChanged="OnMaxFileChanged" />
                                    </Grid>
                                </Border>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Пропускать файлы" />
                                            <TextBlock Classes="desc" Text="Маски через запятую — временные копии и черновики." />
                                        </StackPanel>
                                        <TextBox Grid.Column="1" Width="240" Text="{Binding SkipMasks}"
                                                 LostFocus="OnMasksLostFocus" KeyDown="OnMasksKey" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="h2" Text="КЕШ ДОКУМЕНТОВ" />
                        <Border Classes="group" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto">
                                <Grid x:Name="CacheGrid" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Text="Прочитано" Classes="muted" FontSize="12" Margin="0,2,24,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CacheRead" FontSize="12" Margin="0,2" />
                                    <TextBlock Grid.Row="1" Text="Без текстового слоя" Classes="muted" FontSize="12" Margin="0,2,24,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CacheScans" FontSize="12" Margin="0,2" />
                                    <TextBlock Grid.Row="2" Text="Не прочитались" Classes="muted" FontSize="12" Margin="0,2,24,2" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CacheFailed" FontSize="12" Margin="0,2" />
                                    <TextBlock Grid.Row="3" x:Name="CacheBigLabel" Text="Тяжелее порога" Classes="muted" FontSize="12" Margin="0,2,24,2" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CacheBig" FontSize="12" Margin="0,2" />
                                    <TextBlock Grid.Row="4" Text="Занято на диске" Classes="muted" FontSize="12" Margin="0,2,24,2" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CacheSize" FontSize="12" Margin="0,2" />
                                </Grid>
                                <Button x:Name="ClearCacheButton" Grid.Column="1" Theme="{StaticResource SecondaryButton}"
                                        VerticalAlignment="Top" Content="Очистить" Click="OnClearCache" />
                            </Grid>
                        </Border>
                        <TextBlock Classes="note" Text="Очистка удаляет только прочитанный текст и миниатюры — их можно прочитать заново. Сами PDF не меняются." />
                    </StackPanel>

                    <!-- ══ Лента и карточки ═══════════════════════════════════ -->
                    <StackPanel x:Name="Cards" IsVisible="False">
                        <TextBlock Classes="h2" Text="КАК ВЫГЛЯДИТ КАРТОЧКА" />
                        <Border Classes="group" Padding="14" Background="{DynamicResource BrushInactiveBg}">
                            <StackPanel>
                                <ContentControl x:Name="Preview" />
                                <TextBlock Classes="note" Margin="2,10,0,0"
                                           Text="Пример при поиске «насос центробежный». Без поиска строк найденного текста в карточке нет." />
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="h2" Text="КАРТОЧКА" />
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Размер карточки" />
                                            <TextBlock Classes="desc" Text="Высота строки, размер миниатюры и сколько строк найденного текста видно: 1, 3 или 6." />
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="segment" VerticalAlignment="Center">
                                            <StackPanel x:Name="SizeSegment" Orientation="Horizontal" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Миниатюра первой страницы" />
                                            <TextBlock Classes="desc" Text="Выключено — на плитке только формат листа и число страниц." />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding CardThumbnail}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="h2" Text="ЧТО ПОКАЗЫВАТЬ В КАРТОЧКЕ" />
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Где лежит файл" />
                                            <TextBlock Classes="desc" Text="Строка под названием: источник, папка и имя файла." />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding CardPath}" />
                                    </Grid>
                                </Border>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Размер и страницы" />
                                            <TextBlock Classes="desc" Text="Справа внизу: «3,1 МБ · 48 стр. · A4 × 48»." />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding CardMeta}" />
                                    </Grid>
                                </Border>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Тип документа" />
                                            <TextBlock Classes="desc" Text="Голубая метка справа: Руководство, Чертеж, ГОСТ." />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding CardType}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="h2" Text="КАКИЕ ДОКУМЕНТЫ ПОКАЗЫВАТЬ В ЛЕНТЕ" />
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Документы, которых нет на диске" />
                                            <TextBlock Classes="desc" Text="Показывать с пометкой «файл не найден». Выключено — такие документы скрыты из ленты." />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding FeedMissing}" />
                                    </Grid>
                                </Border>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Сканы без текстового слоя" />
                                            <TextBlock Classes="desc" Text="Показывать с пометкой «скан, без текста». Найти их можно только по названию и имени файла." />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding FeedScans}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══ Оформление ═════════════════════════════════════════ -->
                    <StackPanel x:Name="Look" IsVisible="False">
                        <TextBlock Classes="h2" Text="ТЕМА" />
                        <StackPanel x:Name="ThemeTiles" Orientation="Horizontal" Spacing="12" />
                        <TextBlock Classes="note" Text="Страницы PDF в панели чтения остаются белыми в любой теме — как бумага." />

                        <TextBlock Classes="h2" Text="РАЗМЕРЫ" />
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Масштаб интерфейса" />
                                            <TextBlock Classes="desc" Text="Меняет размер всего окна вместе с текстом и кнопками." />
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="segment" VerticalAlignment="Center">
                                            <StackPanel x:Name="ScaleSegment" Orientation="Horizontal" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Размер шрифта" />
                                            <TextBlock Classes="desc" Text="Только текст; карточки подстраиваются под него сами." />
                                        </StackPanel>
                                        <Border Grid.Column="1" Classes="segment" VerticalAlignment="Center">
                                            <StackPanel x:Name="FontSegment" Orientation="Horizontal" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="h2" Text="ПРИМЕР ТЕКСТА" />
                        <Border Classes="group" Padding="14,12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Насос центробежный ЦНС 38-44. Руководство по эксплуатации" FontWeight="SemiBold" />
                                <TextBlock Text="Проектная документация · Паспорта · ЦНС-38-44_РЭ.pdf" Classes="small muted" />
                                <TextBlock x:Name="SampleNote" Classes="small muted" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ══ Диагностика ════════════════════════════════════════ -->
                    <StackPanel x:Name="Diagnostics" IsVisible="False">
                        <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,10"
                                   Text="Журнал работы программы: запуск, проверка папок, чтение документов и ошибки. Если что-то пошло не так, выгрузите журнал и приложите к обращению." />
                        <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                            <Border Classes="segment">
                                <StackPanel x:Name="LevelSegment" Orientation="Horizontal" />
                            </Border>
                            <TextBlock x:Name="LogCount" Grid.Column="1" Classes="small muted" Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <Border Classes="group">
                            <StackPanel>
                                <Border Background="{DynamicResource BrushSecondaryBg}" Padding="14,6"
                                        BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="{StaticResource BorderLineBottom}">
                                    <Grid ColumnDefinitions="130,130,*">
                                        <TextBlock Text="Время" Classes="small muted bold" />
                                        <TextBlock Grid.Column="1" Text="Уровень" Classes="small muted bold" />
                                        <TextBlock Grid.Column="2" Text="Сообщение" Classes="small muted bold" />
                                    </Grid>
                                </Border>
                                <ItemsControl x:Name="LogRows">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="s:LogRowView">
                                            <StackPanel>
                                                <Button Theme="{StaticResource RowButton}" Height="34" CornerRadius="0" Padding="14,0"
                                                        Click="OnLogRowClick" Classes.on="{Binding IsOpen}">
                                                    <Grid ColumnDefinitions="130,130,*">
                                                        <TextBlock Text="{Binding Time}" Classes="small muted" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Classes="chip" Classes.red="{Binding IsError}"
                                                                Classes.orange="{Binding IsWarning}" Classes.gray="{Binding IsInfo}"
                                                                HorizontalAlignment="Left" Padding="8,2">
                                                            <TextBlock Text="{Binding Level}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                                <Border IsVisible="{Binding IsOpen}" Padding="14,10" Background="{DynamicResource BrushInactiveBg}"
                                                        BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="{StaticResource BorderLineBottom}">
                                                    <StackPanel Spacing="6">
                                                        <SelectableTextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" />
                                                        <SelectableTextBlock Text="{Binding Detail}" Classes="small" TextWrapping="Wrap"
                                                                             Foreground="{DynamicResource BrushSecondaryText}"
                                                                             IsVisible="{Binding HasDetail}" />
                                                        <Button Theme="{StaticResource LinkButton}" Content="Скопировать" FontSize="12"
                                                                Click="OnCopyLog" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="NoLogs" Classes="small muted" Margin="14,12" IsVisible="False"
                                           Text="Записей нет." />
                                <Button x:Name="MoreLogs" Theme="{StaticResource LinkButton}" FontSize="12" Margin="14,10"
                                        Content="Показать еще" Click="OnMoreLogs" IsVisible="False" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="LogNote" Classes="note" />
                    </StackPanel>

                    <!-- ══ О программе ════════════════════════════════════════ -->
                    <StackPanel x:Name="About" IsVisible="False">
                        <Border Classes="group" Padding="16" Margin="0,22,0,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <Image Source="/Assets/Branding/icon-linux.png" Width="64" Height="64" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="3">
                                    <TextBlock Text="Библиотека PDF" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="VersionText" Classes="small muted" />
                                    <TextBlock Classes="desc" Margin="0,4,0,0"
                                               Text="Поиск и чтение PDF-документов. Самостоятельная версия раздела «Библиотека документов» из SmartBase." />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Classes="h2" Text="ОБНОВЛЕНИЯ" />
                        <Border Classes="group">
                            <StackPanel>
                                <Border Classes="srow">
                                    <StackPanel Spacing="8">
                                        <StackPanel>
                                            <TextBlock Text="Папка обновлений" />
                                            <TextBlock Classes="desc" Text="Откуда программа берет новые версии — обычно общая папка в сети." />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Text="{Binding UpdateFolder}" Watermark="Например, \\srv-01\soft\PdfLibrary"
                                                     LostFocus="OnUpdateFolderLostFocus" />
                                            <Button x:Name="CheckUpdateButton" Grid.Column="1" Theme="{StaticResource SecondaryButton}"
                                                    Margin="8,0,0,0" CornerRadius="{StaticResource RadiusSmall}"
                                                    Content="Проверить" Click="OnCheckUpdate" />
                                        </Grid>
                                        <StackPanel x:Name="UpdateStatus" Orientation="Horizontal" Spacing="6" IsVisible="False">
                                            <c:Icon x:Name="UpdateIcon" Classes="small" Data="{StaticResource IconCheck}"
                                                    Foreground="{DynamicResource BrushGreen}" />
                                            <TextBlock x:Name="UpdateText" FontSize="12" TextWrapping="Wrap" />
                                            <Button x:Name="ApplyUpdateButton" Theme="{StaticResource LinkButton}" FontSize="12"
                                                    Content="Обновить" Click="OnApplyUpdate" IsVisible="False" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Classes="srow">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Автообновление" />
                                            <TextBlock Classes="desc" Text="Новая версия ставится сама при следующем запуске программы." />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Theme="{StaticResource Switch}" IsChecked="{Binding AutoUpdate}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Classes="h2" Text="ПАПКА С ДАННЫМИ" />
                        <Border Classes="group" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Margin="0,0,16,0">
                                    <SelectableTextBlock x:Name="DataDirText" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Classes="desc"
                                               Text="library.db — источники, группы и метки; library-cache.db — прочитанный текст для поиска; thumbs — миниатюры; logs.db — журнал." />
                                </StackPanel>
                                <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                        Content="Открыть" Click="OnOpenDataDir" />
                            </Grid>
                        </Border>

                        <TextBlock Classes="h2" Text="СИСТЕМА" />
                        <Border Classes="group" Padding="14,12">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                <TextBlock Text="Операционная система" Classes="muted" FontSize="12" Margin="0,2,24,2" />
                                <TextBlock x:Name="OsText" Grid.Column="1" FontSize="12" Margin="0,2" />
                                <TextBlock Grid.Row="1" Text="Платформа" Classes="muted" FontSize="12" Margin="0,2,24,2" />
                                <TextBlock x:Name="PlatformText" Grid.Row="1" Grid.Column="1" FontSize="12" Margin="0,2" />
                                <TextBlock Grid.Row="2" Text="Библиотека" Classes="muted" FontSize="12" Margin="0,2,24,2" />
                                <TextBlock x:Name="LibraryText" Grid.Row="2" Grid.Column="1" FontSize="12" Margin="0,2" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Panel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
