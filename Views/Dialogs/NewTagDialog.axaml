<d:DialogBase xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="using:PdfLibrary.Views.Dialogs"
              x:Class="PdfLibrary.Views.Dialogs.NewTagDialog">

    <!-- «Метка». -->
    <StackPanel>
        <TextBlock Text="Название метки" Margin="0,0,0,6" FontWeight="{StaticResource FontWeightBold}" Foreground="{DynamicResource BrushSecondaryText}" />
        <TextBox x:Name="NameBox" Watermark="Например, Насосная станция" Margin="0,0,0,12"
                 Height="34" VerticalContentAlignment="Center" CornerRadius="{StaticResource RadiusMedium}"
                 TextChanged="OnNameChanged" />

        <TextBlock Text="Цвет" Margin="0,0,0,6" FontWeight="{StaticResource FontWeightBold}" Foreground="{DynamicResource BrushSecondaryText}" />
        <StackPanel x:Name="Swatches" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12" />

        <CheckBox x:Name="ApplyBox" Margin="0,0,0,12" IsChecked="True" IsVisible="False" />

        <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" Classes="dialog" Content="Отмена" Click="OnCancel" />
            <Button Grid.Column="3" x:Name="CreateButton" Classes="dialog" Content="Создать"
                    Click="OnCreate" IsEnabled="False" />
        </Grid>
    </StackPanel>
</d:DialogBase>
