<d:DialogBase xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="using:PdfLibrary.Views.Dialogs"
              x:Class="PdfLibrary.Views.Dialogs.ConfirmPanel">

    <!-- Подтверждение внутри окна: «Убрать из библиотеки», «Очистить кеш», «Очистить журнал». -->
    <StackPanel Spacing="16">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto,8,Auto">
            <Button Grid.Column="1" Classes="dialog" Content="Отмена" Click="OnCancel" />
            <Button Grid.Column="3" x:Name="OkButton" Classes="dialog" Click="OnOk" />
        </Grid>
    </StackPanel>
</d:DialogBase>
