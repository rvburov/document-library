<d:DialogBase xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="using:PdfLibrary.Views.Dialogs"
              x:Class="PdfLibrary.Views.Dialogs.ConfirmPanel">

    <!-- Подтверждение внутри окна: «Убрать из библиотеки», «Очистить кеш», «Очистить журнал». -->
    <StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
            <Button Theme="{StaticResource SecondaryButton}" Content="Отмена" Click="OnCancel" />
            <Button x:Name="OkButton" Theme="{StaticResource PrimaryButton}" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</d:DialogBase>
