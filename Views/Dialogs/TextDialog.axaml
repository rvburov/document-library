<d:DialogBase xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="using:PdfLibrary.Views.Dialogs"
              x:Class="PdfLibrary.Views.Dialogs.TextDialog">

    <!-- Одно поле: «Переименовать» источник. -->
    <StackPanel>
        <TextBlock x:Name="LabelText" FontSize="12" Margin="0,10,0,6" />
        <TextBox x:Name="ValueBox" TextChanged="OnChanged" KeyDown="OnKey" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,20,0,0">
            <Button Theme="{StaticResource SecondaryButton}" Content="Отмена" Click="OnCancel" />
            <Button x:Name="OkButton" Theme="{StaticResource PrimaryButton}" Content="Сохранить" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</d:DialogBase>
