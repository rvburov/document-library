<d:DialogBase xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="using:PdfLibrary.Views.Dialogs"
              x:Class="PdfLibrary.Views.Dialogs.TextDialog">

    <!-- Одно поле: «Переименовать» источник. -->
    <StackPanel>
        <TextBlock x:Name="LabelText" Margin="0,0,0,6" FontWeight="{StaticResource FontWeightBold}" Foreground="{DynamicResource BrushSecondaryText}" />
        <TextBox x:Name="ValueBox" Margin="0,0,0,12"
                 Height="34" VerticalContentAlignment="Center" CornerRadius="{StaticResource RadiusMedium}"
                 TextChanged="OnChanged" KeyDown="OnKey" />
        <Grid ColumnDefinitions="*,Auto,8,Auto" Margin="0,4,0,0">
            <Button Grid.Column="1" Classes="dialog" Content="Отмена" Click="OnCancel" />
            <Button Grid.Column="3" x:Name="OkButton" Classes="dialog" Content="Сохранить" Click="OnOk" />
        </Grid>
    </StackPanel>
</d:DialogBase>
