<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:PdfLibrary.Controls"
             xmlns:lib="using:PdfLibrary.Views.Library"
             xmlns:r="using:PdfLibrary.Views.Reader"
             x:Class="PdfLibrary.Views.Reader.ReaderScreen">

    <!--
      Экран «Панель чтения» (макет, доска 3): слева узкая лента найденного, справа документ —
      шапка, поиск по документу и масштаб, миниатюры страниц, листы PDF, строка состояния.
    -->
    <Grid x:Name="Layout" ColumnDefinitions="340,*">

        <!-- ── Узкая лента ─────────────────────────────────────────────────── -->
        <Border x:Name="ListPanel" Grid.Column="0" x:DataType="lib:LibraryViewModel"
                BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="{StaticResource BorderLineRight}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Height="{StaticResource NavbarHeight}" Padding="16,0,12,0"
                        BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="{StaticResource BorderLineBottom}">
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <TextBlock Text="Библиотека PDF" Classes="title" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Theme="{StaticResource NavButton}" Classes="on"
                                ToolTip.Tip="Закрыть панель чтения" Click="OnCloseReader">
                            <c:Icon Data="{StaticResource IconReaderClose}" />
                        </Button>
                    </Grid>
                </Border>

                <Border DockPanel.Dock="Top" Margin="16,12,12,8" CornerRadius="{StaticResource RadiusMedium}"
                        ClipToBounds="True" BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="1">
                    <StackPanel>
                        <Grid ColumnDefinitions="Auto,*,Auto" Height="34" Margin="10,0,4,0">
                            <c:Icon Data="{StaticResource IconSearch}" Classes="small"
                                    Foreground="{DynamicResource BrushSecondaryText}" />
                            <TextBox Grid.Column="1" Classes="bare" Margin="8,0" FontSize="12"
                                     Watermark="Найти в документах" Text="{Binding Query}" KeyDown="OnListQueryKey" />
                            <Button Grid.Column="2" Theme="{StaticResource IconButton}" ToolTip.Tip="Очистить"
                                    IsVisible="{Binding Query, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Click="OnListClear">
                                <c:Icon Classes="small" Data="{StaticResource IconClose}" />
                            </Button>
                        </Grid>
                        <Border Background="{DynamicResource BrushSecondaryBg}" Padding="10,4,10,5">
                            <TextBlock Text="{Binding StatusText}" Classes="small muted" TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>
                </Border>

                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="DocList" ItemsSource="{Binding Cards}" Margin="16,0,12,12"
                                  ContainerPrepared="OnListPrepared">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="lib:CardViewModel">
                                <Border Classes="card" Classes.selected="{Binding IsCurrent}" Cursor="Hand"
                                        Margin="0,0,0,6" Padding="10,8" CornerRadius="{StaticResource RadiusMedium}"
                                        BorderThickness="1" PointerPressed="OnListPick">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Width="34" Height="46" CornerRadius="3" ClipToBounds="True"
                                                BorderThickness="1" BorderBrush="{DynamicResource BrushLineStrong}"
                                                Background="{DynamicResource BrushPage}" VerticalAlignment="Top">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" VerticalAlignment="Top" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="3">
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       LineHeight="16" TextWrapping="Wrap" MaxLines="2"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ShortMeta}" Classes="small muted" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Документ ────────────────────────────────────────────────────── -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" x:DataType="r:ReaderViewModel" x:Name="ReaderPanel">

            <Border Grid.Row="0" Height="{StaticResource NavbarHeight}" Padding="20,0,12,0"
                    BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="{StaticResource BorderLineBottom}">
                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeLargeReader}"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Classes="small muted" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="ExpandButton" Grid.Column="1" Theme="{StaticResource NavButton}"
                            ToolTip.Tip="Развернуть документ" Click="OnExpand">
                        <c:Icon Data="{StaticResource IconExpand}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Поиск по документу и масштаб -->
            <Border Grid.Row="1" Padding="20,8,12,8"
                    BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="{StaticResource BorderLineBottom}">
                <Grid ColumnDefinitions="*,Auto">
                    <Border Height="30" MinWidth="220" Padding="10,0,6,0" CornerRadius="{StaticResource RadiusMedium}"
                            BorderThickness="1" BorderBrush="{DynamicResource BrushAccent}">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                            <c:Icon Classes="small" Data="{StaticResource IconSearch}"
                                    Foreground="{DynamicResource BrushSecondaryText}" />
                            <TextBox x:Name="FindBox" Grid.Column="1" Classes="bare" Margin="6,0" FontSize="12"
                                     Watermark="Найти в документе" Text="{Binding FindQuery}" KeyDown="OnFindKey" />
                            <TextBlock Grid.Column="2" Text="{Binding Counter}" Classes="small muted" MinWidth="64"
                                       TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Grid.Column="3" Theme="{StaticResource IconButton}" ToolTip.Tip="Предыдущее совпадение"
                                    Click="OnPrevHit">
                                <c:Icon Classes="small" Data="{StaticResource IconChevronUp}" />
                            </Button>
                            <Button Grid.Column="4" Theme="{StaticResource IconButton}" ToolTip.Tip="Следующее совпадение"
                                    Click="OnNextHit">
                                <c:Icon Classes="small" Data="{StaticResource IconChevronDown}" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="10,0,0,0" Height="30" Padding="2,0"
                            CornerRadius="{StaticResource RadiusMedium}" BorderThickness="1"
                            BorderBrush="{DynamicResource BrushSeparator}" Background="{DynamicResource BrushSecondaryBg}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Уменьшить" Click="OnZoomOut">
                                <c:Icon Classes="small" Data="{StaticResource IconMinus}" />
                            </Button>
                            <TextBlock Text="{Binding ZoomText}" Width="44" TextAlignment="Center" FontSize="12"
                                       VerticalAlignment="Center" />
                            <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Увеличить" Click="OnZoomIn">
                                <c:Icon Classes="small" Data="{StaticResource IconPlus}" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Миниатюры страниц и листы -->
            <Grid Grid.Row="2" ColumnDefinitions="124,*">
                <Border BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="{StaticResource BorderLineRight}">
                    <ScrollViewer x:Name="RailScroll" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Rail" ItemsSource="{Binding Thumbs}" Margin="8,12"
                                      ContainerPrepared="OnRailPrepared">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="r:PageThumb">
                                    <Button Theme="{StaticResource ButtonCore}" HorizontalAlignment="Center"
                                            Margin="0,0,0,10" Click="OnThumbClick">
                                        <Panel>
                                            <StackPanel Spacing="3">
                                                <Border Classes="thumb" Classes.current="{Binding IsCurrent}"
                                                        Width="{Binding Width}" Height="{Binding Height}"
                                                        CornerRadius="3" BorderThickness="2" ClipToBounds="True"
                                                        Background="{DynamicResource BrushPage}">
                                                    <Image Source="{Binding Image}" Stretch="Uniform" />
                                                </Border>
                                                <TextBlock Text="{Binding Number}" FontSize="11" HorizontalAlignment="Center"
                                                           Classes="pageno" Classes.current="{Binding IsCurrent}" />
                                            </StackPanel>
                                            <Border IsVisible="{Binding HasHits}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="0,-4,-2,0" MinWidth="18" Height="18" Padding="5,0" CornerRadius="9"
                                                    Background="{StaticResource BrushBadge}">
                                                <TextBlock Text="{Binding Hits}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource BrushBadgeText}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Panel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Panel Grid.Column="1" Background="{DynamicResource BrushSecondaryBg}">
                    <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Auto"
                                  ScrollChanged="OnPagesScrolled">
                        <r:PageCanvas x:Name="Pages" />
                    </ScrollViewer>
                    <TextBlock Text="{Binding Error}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock x:Name="EmptyText" Text="Выберите документ в ленте слева."
                               Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </Grid>

            <!-- Строка состояния -->
            <Border Grid.Row="3" Height="28" Padding="20,0,12,0"
                    BorderBrush="{DynamicResource BrushSeparator}" BorderThickness="{StaticResource BorderLineTop}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding StatusLeft}" Classes="small muted" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusRight}" Classes="small muted" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
