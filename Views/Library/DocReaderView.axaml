<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PdfLibrary.Views.Library.DocReaderView"
             Background="{DynamicResource BrushBg}">

    <!-- Панель чтения документа: настоящие страницы PDF с подсветкой найденного. Правая колонка главного окна (MainWindow.axaml):
         разделитель слева, ручка ширины и сохранение ширины — у окна, здесь только содержимое. -->

    <UserControl.Styles>
        <!-- Страницы документа: список без всякого вида списка. ListBox взят не ради выделения,
             а ради ДВУХ вещей, которых нет у ItemsControl: виртуализации (том бывает в сотни
             страниц) и ScrollIntoView — им панель прыгает к следующему совпадению. -->
        <Style Selector="ListBox.reader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding"    Value="0" />
        </Style>
        <Style Selector="ListBox.reader ListBoxItem">
            <Setter Property="Padding"   Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor"    Value="Arrow" />
        </Style>
        <!-- Выделения у страниц нет вовсе: текущее совпадение видно по самой подсветке слова,
             а синяя рамка вокруг листа читалась бы как «выбрано», хотя выбирать тут нечего. -->
        <Style Selector="ListBox.reader ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.reader ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- ── Шапка: название документа и раскрытие панели ─────────────────────────── -->
        <Grid Grid.Row="0" Height="56" Margin="16,0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" x:Name="TitleLabel"
                       Text="Документ"
                       VerticalAlignment="Center" Margin="0,0,8,0"
                       FontSize="{DynamicResource FontSizeLarge}"
                       FontWeight="{StaticResource FontWeightBold}"
                       TextTrimming="CharacterEllipsis" />

            <ToggleButton Grid.Column="1" x:Name="ListPanelBtn" Classes="navbtn"
                          Width="30" Height="30"
                          VerticalAlignment="Center"
                          CornerRadius="{StaticResource RadiusMedium}"
                          ToolTip.Tip="Развернуть документ">
                <Viewbox Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="ListOpenIcon"
                              Data="{StaticResource IconArrowRightFromLine}"
                              Stroke="{Binding $parent[ToggleButton].Foreground}"
                              StrokeThickness="{StaticResource IconStrokeMedium}"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                        <Path x:Name="ListCloseIcon"
                              Data="{StaticResource IconArrowLeftToLine}"
                              Stroke="{Binding $parent[ToggleButton].Foreground}"
                              StrokeThickness="{StaticResource IconStrokeMedium}"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>
            </ToggleButton>
        </Grid>

        <Border Grid.Row="1" Classes="separator h" />

        <!-- ── Строка поиска внутри документа ───────────────────────────────── -->
        <!-- Запрос приезжает из поиска раздела: человек нашел документ по слову и нажал
             «Прочитать» — искать это слово второй раз руками он не должен. Дальше строку
             можно править, и это уже поиск ПО ЭТОМУ документу. -->
        <Border Grid.Row="2" Classes="searchBlock" Margin="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="10,0" Height="{StaticResource ControlHeightStandard}">
                <Viewbox Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource IconSearch}"
                              Stroke="{DynamicResource BrushSecondaryText}"
                              StrokeThickness="{StaticResource IconStrokeSmall}"
                              StrokeLineCap="Round" StrokeJoin="Round" />
                    </Canvas>
                </Viewbox>

                <!-- Рамку держит блок; у поля своей нет ни в одном состоянии (класс borderless),
                     иначе при вводе синих рамок было бы две, одна в другой. -->
                <TextBox Grid.Column="1" x:Name="FindBox"
                         Classes="borderless"
                         Watermark="Найти в документе"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Margin="8,0,8,0" />

                <!-- «3 из 17»: ширина фиксированная, иначе смена числа двигала бы кнопки
                     переходов влево-вправо на каждом совпадении. -->
                <TextBlock Grid.Column="2" x:Name="CounterLabel"
                           Text=""
                           MinWidth="64"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushSecondaryText}" />

                <Button Grid.Column="3" x:Name="PrevBtn"
                        Classes="icon" Width="26" Height="26" Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource RadiusBase}"
                        IsEnabled="False"
                        ToolTip.Tip="Предыдущее совпадение">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconChevronUp}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeSmall}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button Grid.Column="4" x:Name="NextBtn"
                        Classes="icon" Width="26" Height="26" Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        CornerRadius="{StaticResource RadiusBase}"
                        IsEnabled="False"
                        ToolTip.Tip="Следующее совпадение">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource IconChevronDown}"
                                  Stroke="{Binding $parent[Button].Foreground}"
                                  StrokeThickness="{StaticResource IconStrokeSmall}"
                                  StrokeLineCap="Round" StrokeJoin="Round" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="3" Classes="separator h" />

        <!-- ── Тело: страницы документа ─────────────────────────────────────── -->
        <!-- Полоса прокрутки вынесена отдельной колонкой и прилегает к правому краю панели:
             своя полоса списка жила бы внутри его отступов и отошла бы от края. -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
            <!-- Страницы документа. Серая подложка — как лист бумаги на столе: белую страницу
                 на белом фоне не видно вовсе. -->
            <ListBox Grid.Column="0" x:Name="PagesList"
                     Classes="reader pages"
                     Background="{DynamicResource BrushSecondaryBg}"
                     Margin="0"
                     Padding="16,12"
                     SelectionMode="Single"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />

            <ScrollBar Grid.Column="1" x:Name="PagesBar"
                       Orientation="Vertical"
                       IsVisible="False" />

            <!-- Состояние вместо страниц: открываю, не открылся, файл пропал. Лежит поверх
                 списка в той же ячейке — списка в этот момент все равно нет. -->
            <TextBlock Grid.Column="0" x:Name="StateLabel"
                       Text=""
                       IsVisible="False"
                       Margin="24"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="{DynamicResource BrushSecondaryText}" />

            <!-- Сообщение закреплено поверх страниц у нижнего края и не уезжает с ними. -->
            <Border Grid.Column="0" x:Name="NoteIsland"
                    IsVisible="{Binding #CutLabel.IsVisible}"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="16,0,16,16" Padding="12,8"
                    Background="{DynamicResource BrushBg}"
                    BorderBrush="{DynamicResource BrushSeparator}"
                    BorderThickness="{DynamicResource BorderLine}"
                    CornerRadius="{StaticResource RadiusMedium}"
                    BoxShadow="0 4 16 0 #22000000">
                <TextBlock x:Name="CutLabel" IsVisible="False"
                           TextWrapping="Wrap" TextAlignment="Center"
                           FontSize="{DynamicResource FontSizeSmall}"
                           Foreground="{DynamicResource BrushSecondaryText}" />
            </Border>
        </Grid>
    </Grid>

</UserControl>
