<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Габариты — токены макета. -->

    <!-- Высота навбара и шапок панелей -->
    <sys:Double x:Key="NavbarHeight">56</sys:Double>
    <!-- Ширина панели разделов слева -->
    <GridLength x:Key="ActivityBarWidth">48</GridLength>
    <!-- Ширина боковой панели (источники и метки, разделы настроек) -->
    <GridLength x:Key="SidebarWidth">232</GridLength>
    <!-- Высота кнопок и полей -->
    <sys:Double x:Key="ControlHeight">30</sys:Double>

    <!-- Скругления: поля и кнопки панели; карточки и меню; диалоги; кнопки-пилюли -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">15</CornerRadius>

    <!-- Линии-разделители одной стороны -->
    <Thickness x:Key="BorderLineBottom">0,0,0,1</Thickness>
    <Thickness x:Key="BorderLineTop">0,1,0,0</Thickness>
    <Thickness x:Key="BorderLineRight">0,0,1,0</Thickness>
    <Thickness x:Key="BorderLineLeft">1,0,0,0</Thickness>

    <!-- Ширина диалогов -->
    <sys:Double x:Key="DialogWidthBase">460</sys:Double>

</ResourceDictionary>
