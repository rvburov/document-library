<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════
         Единое место для всех иконок программы.

         Иконки — это geometry-строки (стиль lucide, сетка 24×24, обводка
         без заливки; кроме стрелок скроллбара — те в своей сетке ~14px).
         Здесь хранится ТОЛЬКО форма (Data). Оформление — Stroke / толщина /
         скругления — остается на самом <Path> в месте использования.

         Использование:
             <Path Data="{StaticResource IconPlus}" Stroke="…" StrokeThickness="…" … />

         Поменять иконку = поменять Data здесь → меняется во всех местах сразу.

         Глиф галочки чекбокса тоже здесь — ключ CheckBoxGlyphGeometry; его
         толщина/размер/радиус остаются в Controls/Widgets/AppCheckBox.axaml.
         ════════════════════════════════════════════════════════════════ -->

    <!-- ═══ РАЗМЕРЫ ИКОНОК (сторона Viewbox, px). Сетка самой иконки всегда 24×24. ═══ -->
    <x:Double x:Key="IconSizeSmall">16</x:Double>   <!-- Маленький -->
    <x:Double x:Key="IconSizeMedium">18</x:Double>  <!-- Средний -->
    <x:Double x:Key="IconSizeLarge">24</x:Double>   <!-- Большой -->
    <x:Double x:Key="IconSizeXLarge">32</x:Double>  <!-- Крупный -->

    <!-- ═══ ТОЛЩИНА ЛИНИЙ ИКОНОК (StrokeThickness обводочного Path).
         Толщина задается В СЕТКЕ 24, а Viewbox потом ужимает иконку до размера, поэтому на
         экране реальная толщина = значение × размер / 24. Чтобы линия выглядела одинаковой при
         разных размерах, для каждого размера — свое значение:
           • Regular ≈ 1.2 px — по умолчанию (почти все иконки);
           • Bold    ≈ 1.5 px — акцентные (кнопка «Создать», галочки).
         ПРАВИЛО: взял размер IconSizeX → бери толщину IconStrokeX (или …Bold для акцентных).
         Не писать «сырые» числа в разметке — только эти токены. ═══ -->
    <x:Double x:Key="IconStrokeSmall">1.8</x:Double>       <!-- 16px → ~1.2px -->
    <x:Double x:Key="IconStrokeMedium">1.6</x:Double>      <!-- 18px → ~1.2px -->
    <x:Double x:Key="IconStrokeLarge">1.2</x:Double>       <!-- 24px → ~1.2px -->
    <x:Double x:Key="IconStrokeXLarge">0.9</x:Double>      <!-- 32px → ~1.2px -->
    <x:Double x:Key="IconStrokeSmallBold">2.2</x:Double>   <!-- 16px → ~1.5px -->
    <x:Double x:Key="IconStrokeMediumBold">2</x:Double>    <!-- 18px → ~1.5px -->
    <x:Double x:Key="IconStrokeLargeBold">1.5</x:Double>   <!-- 24px → ~1.5px -->
    <x:Double x:Key="IconStrokeXLargeBold">1.1</x:Double>  <!-- 32px → ~1.5px -->

    <!-- ═══ ГДЕ КАКОЙ РАЗМЕР. Ставишь иконку в новом месте — держись размера соседей. ═══
         Small  16px — контекстные меню, плашка выбранных, строки настроек, поиск в документе;
         Medium 18px — навбар, тулбар и строки боковой панели, список разделов настроек;
         Large  24px — иконки на экране первого запуска;
         XLarge 32px — панель разделов слева и главная иконка первого запуска. -->

    <!-- ─── Панель разделов: разделы и кнопка сайдбара ─── -->

    <!-- → panel-left-open: сайдбар закрыт, клик откроет -->
    <StreamGeometry x:Key="IconPanelOpen">M5 3 H19 A2 2 0 0 1 21 5 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 Z M9 3 V21 M14 9 L17 12 L14 15</StreamGeometry>
    <!-- ← panel-right-open: сайдбар открыт, клик закроет -->
    <StreamGeometry x:Key="IconPanelClose">M5 3 H19 A2 2 0 0 1 21 5 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 Z M15 3 V21 M10 15 L7 12 L10 9</StreamGeometry>
    <!-- Модуль «Настройки» (lucide settings) -->
    <StreamGeometry x:Key="IconSettings">M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1 -2.33 4.033 2.34 2.34 0 0 0 -3.319 1.915 2.34 2.34 0 0 1 -4.659 0 2.34 2.34 0 0 0 -3.32 -1.915 2.34 2.34 0 0 1 -2.33 -4.033 2.34 2.34 0 0 0 0 -3.831 A2.34 2.34 0 0 1 6.35 6.051 a2.34 2.34 0 0 0 3.319 -1.915 Z M15 12 A3 3 0 0 1 9 12 A3 3 0 0 1 15 12 Z</StreamGeometry>

    <!-- ─── Тулбар сайдбара ─── -->

    <!-- Создать / добавить (plus) -->
    <StreamGeometry x:Key="IconPlus">M5 12 H19 M12 5 V19</StreamGeometry>
    <!-- ⌃⌄ Развернуть все — двойной chevron наружу -->
    <StreamGeometry x:Key="IconExpandAll">M7 15 L12 20 L17 15 M7 9 L12 4 L17 9</StreamGeometry>
    <!-- ⌄⌃ Свернуть все — двойной chevron внутрь -->
    <StreamGeometry x:Key="IconCollapseAll">M7 20 L12 15 L17 20 M7 4 L12 9 L17 4</StreamGeometry>
    <!-- Включить/выключить все (square-check) -->
    <StreamGeometry x:Key="IconSquareCheck">M21 10.656 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 H17.344 M9 11 L12 14 L22 4</StreamGeometry>
    <!-- Выгрузить журнал, копировать в папку (lucide download) -->
    <StreamGeometry x:Key="IconDownload">M12 15 V3 M21 15 v4 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 v-4 M7 10 l5 5 5 -5</StreamGeometry>

    <!-- ─── Сайдбар: иконки строк дерева ─── -->

    <!-- Папка / группа (lucide folder) -->
    <StreamGeometry x:Key="IconFolder">M20 20 A2 2 0 0 0 22 18 V8 A2 2 0 0 0 20 6 H12.1 A2 2 0 0 1 10.41 5.1 L9.6 3.9 A2 2 0 0 0 7.93 3 H4 A2 2 0 0 0 2 5 V18 A2 2 0 0 0 4 20 Z</StreamGeometry>

    <!-- Документ (lucide file-text): значок фонового чтения в панели разделов -->
    <StreamGeometry x:Key="IconFileText">M15 2 H6 A2 2 0 0 0 4 4 V20 A2 2 0 0 0 6 22 H18 A2 2 0 0 0 20 20 V7 Z M14 2 V6 A2 2 0 0 0 16 8 H20 M10 9 H8 M16 13 H8 M16 17 H8</StreamGeometry>

    <!-- ─── Сайдбар: разделы настроек ─── -->

    <!-- Оформление (sun) -->
    <StreamGeometry x:Key="IconSun">M12 8 A4 4 0 1 0 12 16 A4 4 0 1 0 12 8 Z M12 2 V4 M12 20 V22 M4.93 4.93 L6.34 6.34 M17.66 17.66 L19.07 19.07 M2 12 H4 M20 12 H22 M4.93 19.07 L6.34 17.66 M17.66 6.34 L19.07 4.93</StreamGeometry>
    <!-- О программе (info) -->
    <StreamGeometry x:Key="IconInfo">M12 2 A10 10 0 1 0 12 22 A10 10 0 1 0 12 2 Z M12 16 V11 M11.99 8 H12.01</StreamGeometry>
    <!-- Общее (sliders-vertical) -->
    <StreamGeometry x:Key="IconSliders">M10 8 H14 M12 21 V12 M12 8 V3 M17 16 H21 M19 12 V3 M19 21 V16 M3 14 H7 M5 10 V3 M5 21 V14</StreamGeometry>
    <!-- Лента и карточки (book) -->
    <StreamGeometry x:Key="IconBook">M12 7 V21 M3 18 A1 1 0 0 1 2 17 V4 A1 1 0 0 1 3 3 H8 A4 4 0 0 1 12 7 A4 4 0 0 1 16 3 H21 A1 1 0 0 1 22 4 V17 A1 1 0 0 1 21 18 H15 A3 3 0 0 0 12 21 A3 3 0 0 0 9 18 Z</StreamGeometry>

    <!-- ─── Навбары: toggle боковых панелей ─── -->

    <!-- ←| arrow-left-from-line: панель закрыта, клик откроет -->
    <StreamGeometry x:Key="IconArrowLeftFromLine">M9 6 L3 12 L9 18 M3 12 H17 M21 19 V5</StreamGeometry>
    <!-- →| arrow-right-to-line: панель открыта, клик закроет -->
    <StreamGeometry x:Key="IconArrowRightToLine">M17 12 H3 M11 18 L17 12 L11 6 M21 5 V19</StreamGeometry>
    <!-- |→ arrow-right-from-line: панель закрыта, клик откроет -->
    <StreamGeometry x:Key="IconArrowRightFromLine">M3 5 V19 M21 12 H7 M15 18 L21 12 L15 6</StreamGeometry>
    <!-- |← arrow-left-to-line: панель открыта, клик закроет -->
    <StreamGeometry x:Key="IconArrowLeftToLine">M3 19 V5 M13 6 L7 12 L13 18 M7 12 H21</StreamGeometry>

    <!-- ─── Навигация ─── -->

    <!-- › chevron-right (экран вперед) -->
    <StreamGeometry x:Key="IconChevronRight">M9 18 L15 12 L9 6</StreamGeometry>
    <!-- ⌄ chevron-down (выпадающие списки, аккордеоны) -->
    <StreamGeometry x:Key="IconChevronDown">M6 9 L12 15 L18 9</StreamGeometry>
    <!-- ⌃ chevron-up (переход к предыдущему совпадению в панели чтения) -->
    <StreamGeometry x:Key="IconChevronUp">M18 15 L12 9 L6 15</StreamGeometry>
    <!-- ⌄ chevron-down ЗАЛИВКОЙ для ComboBox (PathIcon, своя сетка ~12×8) -->
    <StreamGeometry x:Key="IconChevronDownFilled">M1 1 L6 6 L11 1 L12.4 2.4 L6 8.8 L-0.4 2.4 Z</StreamGeometry>

    <!-- ─── Действия ─── -->

    <!-- Поиск (lucide search) — якорь строки поиска в ленте и панели чтения -->
    <StreamGeometry x:Key="IconSearch">M21 21 L16.65 16.65 M11 3 A8 8 0 1 0 11 19 A8 8 0 1 0 11 3 Z</StreamGeometry>
    <!-- Открыть снаружи (lucide square-arrow-out-up-right) — «Открыть» в карточке документа:
         файл уходит в чужую программу, и стрелка из рамки говорит именно это -->
    <StreamGeometry x:Key="IconOpenExternal">M21 13 V19 A2 2 0 0 1 19 21 H5 A2 2 0 0 1 3 19 V5 A2 2 0 0 1 5 3 H11 M15 3 H21 V9 M10 14 L21 3</StreamGeometry>
    <!-- Редактировать (pen) -->
    <StreamGeometry x:Key="IconPencil">M13 21 H21 M15 5 L19 9 M21.174 6.812 A1 1 0 0 0 17.188 2.825 L3.842 16.174 A2 2 0 0 0 3.342 17.004 L2.021 21.356 A0.5 0.5 0 0 0 2.644 21.978 L6.997 20.658 A2 2 0 0 0 7.827 20.161 Z</StreamGeometry>
    <!-- Диагностика (lucide code) -->
    <StreamGeometry x:Key="IconCode">M18 16 L22 12 L18 8 M6 8 L2 12 L6 16 M14.5 4 L9.5 20</StreamGeometry>
    <!-- Прочитать документ в панели чтения (lucide book-open) -->
    <StreamGeometry x:Key="IconBookOpen">M12 5 V21 M20.001 19 A2 2 0 0 0 22 17 V5 A2 2 0 0 0 20.001 3 L16 3.002 A5 5 0 0 0 12 5 A5 5 0 0 0 8 3 H4 A2 2 0 0 0 2 5 V17 A2 2 0 0 0 3.999 19 H8 A5 5 0 0 1 12 21 A5 5 0 0 1 16 19 Z</StreamGeometry>
    <!-- Лента в панели разделов (lucide book-open-text): тот же
         разворот, что у IconBookOpen, плюс строки текста на страницах. -->
    <StreamGeometry x:Key="IconBookOpenText">M12 5 V21 M20.001 19 A2 2 0 0 0 22 17 V5 A2 2 0 0 0 20.001 3 L16 3.002 A5 5 0 0 0 12 5 A5 5 0 0 0 8 3 H4 A2 2 0 0 0 2 5 V17 A2 2 0 0 0 3.999 19 H8 A5 5 0 0 1 12 21 A5 5 0 0 1 16 19 Z M6 9 H8 M6 13 H8 M16 9 H18 M16 13 H18</StreamGeometry>
    <!-- Удалить (trash) -->
    <StreamGeometry x:Key="IconTrash">M3 6 H21 M8 6 V4 A1 1 0 0 1 9 3 H15 A1 1 0 0 1 16 4 V6 M19 6 V20 A2 2 0 0 1 17 22 H7 A2 2 0 0 1 5 20 V6 M10 11 V17 M14 11 V17</StreamGeometry>
    <!-- Глаз закрытый веком (lucide eye-closed) — «Выключить все источники группы». Не
         перечеркнутый глаз: диагональ поверх дуг дает слишком много линий на 16 px -->
    <StreamGeometry x:Key="IconEyeClosed">M2 8 A10.645 10.645 0 0 0 22 8 M4 15 L5.726 12.95 M9 18 L9.722 14.75 M15 18 L14.278 14.75 M20 15 L18.274 12.95</StreamGeometry>

    <!-- ─── Поля и баннеры ─── -->

    <!-- Часы (lucide clock-4): круг + стрелки на 4 часа, «Текст читается в фоне» на первом запуске -->
    <StreamGeometry x:Key="IconClock">M2 12 A10 10 0 0 1 22 12 A10 10 0 0 1 2 12 Z M12 6 V12 L16 14</StreamGeometry>
    <!-- Восклицательный знак баннера ошибки (тело «!» в красном круге) -->
    <StreamGeometry x:Key="IconAlertMark">M12 6 L12 14 M12 17 L12 18.5</StreamGeometry>
    <!-- Галочка чекбокса (общая для CheckBox и «ручного» чекбокса в строках боковой панели).
         Толщина/размер/радиус — в Controls/Widgets/AppCheckBox.axaml. -->
    <StreamGeometry x:Key="CheckBoxGlyphGeometry">M5 13 L10 18 L19 7</StreamGeometry>

    <!-- ─── Контекстное меню: иконки пунктов (lucide) ─── -->

    <!-- Расположение (folder-tree) -->
    <StreamGeometry x:Key="IconFolderTree">M20 10a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1h-2.5a1 1 0 0 1-.8-.4l-.9-1.2A1 1 0 0 0 15 3h-2a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1Z M20 21a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1h-2.9a1 1 0 0 1-.88-.55l-.42-.85a1 1 0 0 0-.92-.6H13a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1Z M3 5a2 2 0 0 0 2 2h3 M3 3v13a2 2 0 0 0 2 2h3</StreamGeometry>
    <!-- Создать группу (folder-plus) -->
    <StreamGeometry x:Key="IconFolderPlus">M12 10v6 M9 13h6 M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z</StreamGeometry>

    <!-- ─── Меню фильтра и сортировки ─── -->

    <!-- Сортировка А→Я (arrow-down-a-z) -->
    <StreamGeometry x:Key="IconSortAz">M3 16 l4 4 4 -4 M7 20 V4 M20 8 h-5 M15 10 V6.5 a2.5 2.5 0 0 1 5 0 V10 M15 14 h5 l-5 6 h5</StreamGeometry>
    <!-- Сортировка Я→А (arrow-up-z-a) -->
    <StreamGeometry x:Key="IconSortZa">M3 8 l4 -4 4 4 M7 4 v16 M15 4 h5 l-5 6 h5 M15 20 v-3.5 a2.5 2.5 0 0 1 5 0 V20 M20 18 h-5</StreamGeometry>
    <!-- ✓ Галочка (check) -->
    <StreamGeometry x:Key="IconCheck">M20 6 L9 17 l-5 -5</StreamGeometry>
    <!-- ✕ Крестик / закрыть (x) -->
    <StreamGeometry x:Key="IconClose">M18 6 L6 18 M6 6 L18 18</StreamGeometry>

    <!-- ─── Стрелки скроллбара (Classes="arrow") ───
         Рисуются в рамке 16×8 (вертикальные) и 8×16 (горизонтальные) — это размер Canvas
         в шаблоне полосы. Чертеж отступает от края рамки на 2 единицы, обводка (толщина 2,
         круглые торцы) съедает 1 → между краской и краем рамки остается запас в 1 единицу.
         Запас обязателен: раньше чертеж стоял впритык, и Viewbox при дробном масштабе
         срезал торцы шевронов. Меняете геометрию — сохраняйте отступ 2 от всех краев. -->

    <!-- ⌃ вверх -->
    <StreamGeometry x:Key="IconScrollUp">M2 6 L8 2 L14 6</StreamGeometry>
    <!-- ⌄ вниз -->
    <StreamGeometry x:Key="IconScrollDown">M2 2 L8 6 L14 2</StreamGeometry>
    <!-- ‹ влево -->
    <StreamGeometry x:Key="IconScrollLeft">M6 2 L2 8 L6 14</StreamGeometry>
    <!-- › вправо -->
    <StreamGeometry x:Key="IconScrollRight">M2 2 L6 8 L2 14</StreamGeometry>

    <!-- ── Иконки разделов ленты: метки, группы источников, проверка папок ── -->
    <!-- tag: метка документа (строки меток в боковой панели, панель выбранных) -->
    <StreamGeometry x:Key="IconTag">M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z M7 7.5 A.5 .5 0 1 0 8 7.5 A.5 .5 0 1 0 7 7.5 Z</StreamGeometry>
    <!-- refresh-cw: «Проверить папки» -->
    <StreamGeometry x:Key="IconRefresh">M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5</StreamGeometry>
    <!-- folders: группа источников -->
    <StreamGeometry x:Key="IconFolders">M20 17a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3.9a2 2 0 0 1-1.69-.9l-.81-1.2a2 2 0 0 0-1.67-.9H8a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2Z M2 8v11a2 2 0 0 0 2 2h14</StreamGeometry>
    <!-- ellipsis: «Действия с папкой» в списке источников настроек -->
    <StreamGeometry x:Key="IconMore">M11 12 A1 1 0 1 0 13 12 A1 1 0 1 0 11 12 Z M18 12 A1 1 0 1 0 20 12 A1 1 0 1 0 18 12 Z M4 12 A1 1 0 1 0 6 12 A1 1 0 1 0 4 12 Z</StreamGeometry>


    <!-- Значки колонок диагностики и активного фильтра. -->
    <StreamGeometry x:Key="IconFieldStatus">M12 13 V2 l8 4 -8 4 M20.561 10.222 a9 9 0 1 1 -12.55 -5.29 M8.002 9.997 a5 5 0 1 0 8.9 2.02</StreamGeometry>
    <StreamGeometry x:Key="IconMessageWarning">M2.992 16.342 a2 2 0 0 1 0.094 1.167 l-1.065 3.29 a1 1 0 0 0 1.236 1.168 l3.413 -0.998 a2 2 0 0 1 1.099 0.092 a10 10 0 1 0 -4.777 -4.719 M12 8 v4 M12 16 h0.01</StreamGeometry>
    <StreamGeometry x:Key="IconTriangleAlert">M21.73 18 l-8 -14 a2 2 0 0 0 -3.48 0 l-8 14 A2 2 0 0 0 4 21 h16 a2 2 0 0 0 1.73 -3 M12 9 v4 M12 17 h0.01</StreamGeometry>
    <StreamGeometry x:Key="IconFilter">M10 20a1 1 0 0 0 .553.895l2 1A1 1 0 0 0 14 21v-7a2 2 0 0 1 .517-1.341L21.74 4.67A1 1 0 0 0 21 3H3a1 1 0 0 0-.742 1.67l7.225 7.989A2 2 0 0 1 10 14z</StreamGeometry>
    <StreamGeometry x:Key="IconCopy">M15 12v6 M12 15h6 M10 8 H20 A2 2 0 0 1 22 10 V20 A2 2 0 0 1 20 22 H10 A2 2 0 0 1 8 20 V10 A2 2 0 0 1 10 8 Z M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2</StreamGeometry>
</ResourceDictionary>
